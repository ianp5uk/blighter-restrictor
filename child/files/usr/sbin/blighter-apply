#!/usr/bin/python3
# -----------------------------------------------------------------------------
# Blighter Restrictor - child-PC helper (runs as root via sudo).
#
# Purpose: the ONLY privileged command the parent app may run on a child's
# PC.  The "blighter" admin account is allowed to run exactly this program
# through /etc/sudoers.d/blighter, so this file strictly validates its
# arguments and input.  It never runs arbitrary commands.
#
# Commands (output is JSON unless stated):
#   get                 current mode, allow list, block list and config text
#   status              Squid / firewall / proxy state of the PC
#   set                 read {"mode","allow","block"[,"discord","home_net","opera"]} JSON on stdin, validate,
#                       back up, write, check with "squid -k parse", reload
#                       Squid; restore the previous files if anything fails
#   reload              rewrite rules.conf from the saved lists and re-read
#                       config ("restart Squid on command")
#   log N [rotated]     plain text: last N lines of the Squid access log,
#                       optionally including older rotated logs
#   logstart N [rotated]  JSON: the last N lines plus the log position
#   lognext INO OFFSET  JSON: only the lines written since that position
#                       (see common/logtail.py) - the parent app collects
#                       activity with these without fetching lines twice
#   init                (used by blighter-setup) create default files if absent
#   netinfo             the networks the PC is on now (for the home network setting)
#   filtered|block|open [local]
#                       the Controls tab's three-way switch (since 1.3.0):
#                       the filters apply / every site and Discord blocked
#                       (home network as its switch says) / every site and
#                       Discord allowed.  The filters themselves are kept.
#                       The firewall stays on in all three, so web traffic
#                       always goes through Squid and is always recorded.
#                       "local" records that it was set on the PC itself
#                       (sudo blighter-apply open local) rather than by the
#                       parent app.  Replaces 1.2.x's pause / resume.
#   logout              log the child's account out (unsaved work is lost)
#   shutdown / restart  switch the PC off / restart it, 5 seconds after
#                       replying (so the parent app gets the answer)
#   action logout|restart|shutdown 0|5|15
#                       the same, straight away (0) or after a warning on the
#                       child's screen at 5 minutes, or at 15 and 5 minutes
#                       (since 1.4.0).  "action cancel" cancels a waiting one
#   login-set           read the login times JSON on stdin (see
#                       common/lockout.py) and put it in force
#   extend HH:MM|end    extra time: the child may log in until HH:MM today
#   tick                the minute check run by blighter-login.timer: lock /
#                       unlock the child's account, warnings, warned actions
#   release             unlock the child's account if Blighter locked it
#                       (used by blighter-setup --remove)
# Login times lock the child's account by giving it an expiry date in the
# past (usermod -e 1: no new logins of any kind) and unlock it by putting
# back the expiry it had before (normally none).  Only the recorded child
# account is ever locked - never an administrator, never "blighter".
#   banner              (since 1.4.0; used by blighter-setup, the package
#                       upgrade and at boot) rewrite /etc/blighter/ssh-banner,
#                       the one line the SSH server shows the "blighter"
#                       account before login, e.g.
#                       "Blighter child 1.4.0 · Jacks-Laptop · Ubuntu 24.04",
#                       so the parent app's "Find PCs" can recognise this PC
#                       without a password (this version, the PC's own name
#                       read now, the system).  Nothing if setup has not run.
#
# Copyright (C) 2026 Ian Packer
# SPDX-License-Identifier: GPL-3.0-or-later
# This program is free software: you can redistribute it and/or modify it
# under the terms of the GNU General Public License as published by the Free
# Software Foundation, either version 3 of the License, or (at your option)
# any later version.  It is distributed WITHOUT ANY WARRANTY; see the
# LICENSE file or <https://www.gnu.org/licenses/> for details.
# -----------------------------------------------------------------------------

import gzip
import ipaddress
import json
import os
import shutil
import socket
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/blighter-child")
import domains  # noqa: E402  (shared validation, same file as the parent app)
import blockpage  # noqa: E402  (neutral error pages, same file as the Windows helper)
import logtail  # noqa: E402  (incremental log reading, same file as the Windows helper)
import lockout  # noqa: E402  (login times and warned actions, same file as the Windows helper)

VERSION = "1.4.0"
BASE = "/etc/squid/blighter"
MODE_FILE = os.path.join(BASE, "mode")
ALLOW_FILE = os.path.join(BASE, "allow.list")
BLOCK_FILE = os.path.join(BASE, "block.list")
RULES_FILE = os.path.join(BASE, "rules.conf")
PREV_DIR = os.path.join(BASE, ".previous")
ERR_DIR = os.path.join(BASE, "errors")
STOCK_ERR_DIRS = ("/usr/share/squid/errors/templates", "/usr/share/squid/errors/en")
SQUID_CONF = "/etc/squid/squid.conf"
CHILD_CONF = "/etc/blighter/child.conf"
CONTROL_FILE = "/etc/blighter/control"   # "open parent 2026-11-28 14:32:00"; missing = filtered
LEGACY_PAUSED = "/etc/blighter/paused"   # 1.2.x Pause (now Open all), migrated by init / reload
LOG_DIR = "/var/log/squid"
LOGIN_DIR = "/etc/blighter/login"        # login times: schedule, extra time, warned action, lock state
PREV_EXPIRE = os.path.join(LOGIN_DIR, "previous-expiry")
ADMIN_USER = "blighter"
MANAGED = (MODE_FILE, ALLOW_FILE, BLOCK_FILE, RULES_FILE)
MAX_LOG_LINES = 100000

DEFAULT_ALLOW = """# Sites allowed when the mode is "Block all, allow some".
# One domain per line.  A leading dot means "this domain and all subdomains".
# (Discord is not in this list: it has its own "Allow Discord" switch.)
# A placeholder to show the format - replace it with the sites to allow.
.example.com
"""

DEFAULT_BLOCK = """# Sites blocked when the mode is "Allow all, block some".
# One domain per line.  A leading dot means "this domain and all subdomains".
# Game stores / launchers
.steampowered.com
.steamcommunity.com
.steamstatic.com
.epicgames.com
.roblox.com
"""


def out(obj, code=0):
    print(json.dumps(obj))
    sys.exit(code)


def read(path, default=""):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        return default


def write(path, text):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, 0o640)
    try:
        shutil.chown(tmp, "root", "proxy")
    except (LookupError, PermissionError):
        pass
    os.replace(tmp, path)


# ---- Per-child switches, stored in child.conf -----------------------------------
#   ALLOW_VOICE_UDP   yes/no   Discord allowed (Squid rules + UDP 50000-65535)
#   HOME_NET_ALLOWED  yes/no   home network access (firewall + Squid)
#   HOME_NETS         "192.168.18.0/24 ..."   the home network's subnet(s)
#   HOME_NET_NAME     the network's name when it was recorded (for display)
#   BLOCK_OPERA       yes/no   Opera downloads blocked in Squid (default yes)
def conf_value(key, default=""):
    for line in read(CHILD_CONF).splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            k, v = line.split("=", 1)
            if k.strip() == key:
                return v.strip().strip('"')
    return default


def save_conf(values):
    """Set KEY="value" lines in child.conf (adding missing keys at the end)."""
    lines = read(CHILD_CONF).splitlines()
    for key, value in values.items():
        new = f'{key}="{value}"'
        for i, line in enumerate(lines):
            if not line.lstrip().startswith("#") and line.split("=", 1)[0].strip() == key:
                lines[i] = new
                break
        else:
            lines.append(new)
    write(CHILD_CONF, "\n".join(lines) + "\n")
    fix_conf_permissions()


def discord_allowed():
    """Discord allowed?  One setting covers the Squid rules AND the firewall's
    UDP 50000-65535 opening for voice/video."""
    return conf_value("ALLOW_VOICE_UDP", "yes") != "no"


def opera_blocked():
    """Opera downloads blocked?  (Missing from child.conf = yes, so updated
    PCs get the block too.)"""
    return conf_value("BLOCK_OPERA", "yes") != "no"


def home_net():
    """The home network switch: {"allowed", "subnets", "name"}."""
    subnets, _, _ = domains.clean_subnets(conf_value("HOME_NETS").split())
    return {"allowed": conf_value("HOME_NET_ALLOWED", "yes") != "no",
            "subnets": subnets, "name": conf_value("HOME_NET_NAME")}


def parse_options(data):
    """Read the optional "discord" and "home_net" parts of a set request.
    Older parent apps send neither; then the PC's settings are kept.
    Returns (discord, home, errors, warnings)."""
    discord = data.get("discord")
    discord = discord_allowed() if discord is None else bool(discord)
    home = home_net()
    errors, warnings = [], []
    h = data.get("home_net")
    if isinstance(h, dict):
        subnets, errors, warnings = domains.clean_subnets([str(x) for x in h.get("subnets", [])])
        name = str(h.get("name", home["name"]))[:80].replace('"', "'")
        if subnets != home["subnets"] and "name" not in h:
            name = ""
        home = {"allowed": bool(h.get("allowed", home["allowed"])), "subnets": subnets, "name": name}
        if home["allowed"] and not subnets:
            warnings.append("Home network access is on but no home network is set - nothing extra is allowed.")
    return discord, home, [f"Home network: {e}" for e in errors], warnings


def fix_conf_permissions(path=CHILD_CONF):
    # Keep the permissions blighter-setup gave it (write() uses Squid's 0640 root:proxy).
    # The firewall script reads these as root, so world-readable is fine.
    os.chmod(path, 0o644)
    try:
        shutil.chown(path, "root", "root")
    except (LookupError, PermissionError):
        pass


def read_control():
    """{"state", "by", "since"}: the Controls tab's switch as stored on the PC.
    by is "parent" (the parent app) or "pc" (set on the PC itself)."""
    parts = read(CONTROL_FILE).split(None, 2)
    state = parts[0] if parts and parts[0] in domains.CONTROLS else domains.CONTROL_FILTERED
    if not parts and os.path.exists(LEGACY_PAUSED):      # not migrated yet
        state = domains.CONTROL_OPEN
    by = parts[1] if len(parts) > 1 and parts[1] in ("parent", "pc") else "parent"
    since = parts[2].strip() if len(parts) > 2 else ""
    return {"state": state, "by": by, "since": since}


def control_state():
    return read_control()["state"]


def write_control(state, by):
    os.makedirs(os.path.dirname(CONTROL_FILE), exist_ok=True)
    write(CONTROL_FILE, f"{state} {by} {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
    fix_conf_permissions(CONTROL_FILE)


def migrate_legacy():
    """1.2.x's Pause flag becomes Open all.  True if anything changed."""
    if not os.path.exists(LEGACY_PAUSED):
        return False
    if not os.path.exists(CONTROL_FILE):
        write_control(domains.CONTROL_OPEN, "parent")
    os.remove(LEGACY_PAUSED)
    return True


def apply_firewall_options():
    """Re-create the nftables rules (Discord voice, home network) from child.conf and the Controls switch."""
    if have_systemd():
        return run(["systemctl", "reload-or-restart", "blighter-firewall.service"])
    return run(["/usr/sbin/blighter-firewall", "start"])


def read_mode():
    m = read(MODE_FILE, domains.MODE_BLOCKLIST).strip()
    return m if m in domains.MODES else domains.MODE_BLOCKLIST


def render_rules(mode, allow_lines, block_lines, discord=None, home=None, opera=None):
    # The neutral error pages must exist before Squid reads this file.
    blockpage.write_pages(ERR_DIR, STOCK_ERR_DIRS)
    head = ("# Generated by Blighter Restrictor - do not edit by hand.\n"
            f"# Mode: {mode}\n" + blockpage.squid_lines(ERR_DIR))
    if discord is None:
        discord = discord_allowed()
    if home is None:
        home = home_net()
    if opera is None:
        opera = opera_blocked()
    control = control_state()
    if control != domains.CONTROL_FILTERED:
        # Block all / Open all: the filters are kept on disk but not used.
        return head + domains.control_rules(control, home["allowed"], home["subnets"])
    head += domains.home_net_rules(home["allowed"], home["subnets"])
    head += domains.opera_rules(opera)
    head += domains.discord_rules(discord)
    if mode == domains.MODE_ALLOWLIST:
        if domains.entries_only(allow_lines):
            return head + (f'acl blighter_allow dstdomain "{ALLOW_FILE}"\n'
                           "http_access allow localhost blighter_allow\n")
        return head + "# Allow list is empty: everything is blocked.\n"
    body = head
    if domains.entries_only(block_lines):
        body += (f'acl blighter_block dstdomain "{BLOCK_FILE}"\n'
                 "http_access deny blighter_block\n")
    return body + "http_access allow localhost\n"


def have_systemd():
    return os.path.isdir("/run/systemd/system")


def run(cmd):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError as e:      # e.g. nmcli on a PC without NetworkManager
        return 127, str(e)
    return p.returncode, (p.stdout + p.stderr).strip()


def squid_parse():
    return run(["squid", "-k", "parse", "-f", SQUID_CONF])


def squid_running():
    if have_systemd():
        return run(["systemctl", "is-active", "--quiet", "squid"])[0] == 0
    return run(["squid", "-k", "check"])[0] == 0


def squid_reload():
    """Reload if running, start if not.  Returns (ok, message)."""
    if have_systemd():
        if squid_running():
            code, msg = run(["systemctl", "reload", "squid"])
        else:
            code, msg = run(["systemctl", "start", "squid"])
    else:
        if squid_running():
            code, msg = run(["squid", "-k", "reconfigure"])
        else:
            code, msg = run(["squid", "-f", SQUID_CONF])
    return code == 0, msg


def parse_errors(text):
    keep = [l for l in text.splitlines() if "ERROR" in l or "FATAL" in l or "WARNING" in l]
    return "\n".join(keep[-15:]) or text[-1500:]


def cmd_get():
    out({
        "helper_version": VERSION,
        "mode": read_mode(),
        "allow": read(ALLOW_FILE).splitlines(),
        "block": read(BLOCK_FILE).splitlines(),
        "rules_conf": read(RULES_FILE),
        "squid_conf": read(SQUID_CONF),
        "discord": discord_allowed(),
        "home_net": home_net(),
        "opera": opera_blocked(),
        "control": read_control(),
        "login": engine().describe(),
    })


def cmd_status():
    child = {}
    for line in read(CHILD_CONF).splitlines():
        if "=" in line and not line.startswith("#"):
            k, v = line.split("=", 1)
            child[k.strip()] = v.strip().strip('"')
    code, fw = run(["nft", "list", "table", "inet", "blighter"])
    _, ver = run(["squid", "-v"])
    user = child.get("CHILD_USER", "?")
    _, groups = run(["id", "-nG", user])
    is_admin = bool(set(groups.split()) & {"sudo", "admin", "wheel"}) if user != "?" else None
    warnings = ([f"The child's account '{user}' is an ADMINISTRATOR (sudo) - they can undo all of this."]
                if is_admin else [])
    out({
        "helper_version": VERSION,
        "platform": "linux",
        "child_is_admin": is_admin,
        "warnings": warnings,
        "child_user": child.get("CHILD_USER", "?"),
        "voice_udp": child.get("ALLOW_VOICE_UDP", "yes"),
        "squid_version": ver.splitlines()[0] if ver else "?",
        "squid_running": squid_running(),
        "squid_conf_managed": "Blighter Restrictor" in read(SQUID_CONF)[:400],
        "firewall_active": code == 0,
        "bypassed": False,
        "firewall_rules": control_banner() + (fw if code == 0 else "Firewall table not loaded"),
        "proxy_locked": os.path.exists("/etc/dconf/db/local.d/locks/00-blighter-proxy"),
        "control": read_control(),
        "home_net": home_net(),
    })


def cmd_set():
    try:
        data = json.loads(sys.stdin.read(2_000_000))
    except ValueError:
        out({"ok": False, "message": "Input was not valid JSON"}, 1)
    mode = data.get("mode")
    if mode not in domains.MODES:
        out({"ok": False, "message": f"Unknown mode {mode!r}"}, 1)
    allow, n1, e1 = domains.clean_list([str(x) for x in data.get("allow", [])])
    block, n2, e2 = domains.clean_list([str(x) for x in data.get("block", [])])
    errors = [f"Allow list {e}" for e in e1] + [f"Block list {e}" for e in e2]
    if errors:
        out({"ok": False, "message": "Lists contain errors - nothing changed.", "errors": errors}, 1)

    # Back up the current files so we can roll back.
    os.makedirs(PREV_DIR, exist_ok=True)
    for p in MANAGED:
        dst = os.path.join(PREV_DIR, os.path.basename(p))
        if os.path.exists(p):
            shutil.copy2(p, dst)
        elif os.path.exists(dst):
            os.remove(dst)

    discord, home, opt_errors, opt_warnings = parse_options(data)
    if opt_errors:
        out({"ok": False, "message": "Settings contain errors - nothing changed.", "errors": opt_errors}, 1)
    opera = data.get("opera")
    opera = opera_blocked() if opera is None else bool(opera)
    discord_changed = discord != discord_allowed()
    home_changed = home != home_net()
    opera_changed = opera != opera_blocked()

    write(ALLOW_FILE, "\n".join(allow) + "\n")
    write(BLOCK_FILE, "\n".join(block) + "\n")
    write(MODE_FILE, mode + "\n")
    write(RULES_FILE, render_rules(mode, allow, block, discord, home, opera))

    code, msg = squid_parse()
    ok = code == 0
    reload_msg = ""
    if ok:
        ok, reload_msg = squid_reload()
    if not ok:
        for p in MANAGED:
            src = os.path.join(PREV_DIR, os.path.basename(p))
            if os.path.exists(src):
                shutil.copy2(src, p)
        squid_reload()
        out({"ok": False,
             "message": "Squid rejected the new configuration - previous rules restored.",
             "errors": [parse_errors(msg + "\n" + reload_msg)]}, 1)

    message = "Applied and Squid reloaded."
    if discord_changed or home_changed or opera_changed:
        # Squid accepted the rules; now the settings (and the firewall) follow.
        save_conf({"ALLOW_VOICE_UDP": "yes" if discord else "no",
                   "HOME_NET_ALLOWED": "yes" if home["allowed"] else "no",
                   "HOME_NETS": " ".join(home["subnets"]),
                   "HOME_NET_NAME": home["name"],
                   "BLOCK_OPERA": "yes" if opera else "no"})
        if opera_changed:
            message += " Opera downloads " + ("blocked." if opera else "allowed.")
    if discord_changed or home_changed:
        fw_code, fw_msg = apply_firewall_options()
        if discord_changed:
            message += " Discord " + ("allowed." if discord else "blocked.")
        if home_changed:
            message += " Home network access " + ("on." if home["allowed"] else "off.")
        if fw_code != 0:
            message += " WARNING: the PC's firewall could not be updated: " + fw_msg[-300:]
    warn = [l for l in msg.splitlines() if "WARNING" in l] + opt_warnings
    out({"ok": True, "message": message, "discord": discord_allowed(), "home_net": home_net(),
         "opera": opera_blocked(),
         "control": read_control(),
         "notes": n1 + n2, "warnings": warn[-10:],
         "allow": allow, "block": block, "mode": mode})


def networks_from(entries):
    """entries: [(address, prefixlen, name)] -> [{"subnet", "name", "private", "address"}]."""
    nets, seen = [], set()
    for addr, plen, name in entries:
        try:
            iface = ipaddress.ip_interface(f"{addr}/{plen}")
        except ValueError:
            continue
        net = iface.network
        if net.is_loopback or net.is_link_local or str(net) in seen:
            continue
        seen.add(str(net))
        nets.append({"subnet": str(net), "name": name or "", "address": str(iface.ip),
                     "private": domains.is_private_net(net)})
    return nets


def current_networks():
    """The networks this PC is on now (via its default routes), with names."""
    code, text = run(["ip", "-j", "route", "show", "default"])
    devs = []
    try:
        for r in json.loads(text) if code == 0 else []:
            if r.get("dev") and r["dev"] not in devs:
                devs.append(r["dev"])
    except ValueError:
        pass
    names = {}
    code, text = run(["nmcli", "-t", "-f", "NAME,DEVICE", "connection", "show", "--active"])
    if code == 0:
        for line in text.splitlines():
            name, _, dev = line.rpartition(":")
            if dev:
                names[dev] = name.replace("\\:", ":")
    entries = []
    for dev in devs:
        code, text = run(["ip", "-j", "-4", "addr", "show", "dev", dev])
        try:
            for link in json.loads(text) if code == 0 else []:
                for a in link.get("addr_info", []):
                    entries.append((a.get("local"), a.get("prefixlen"), names.get(dev, dev)))
        except ValueError:
            pass
    return networks_from(entries)


def cmd_netinfo():
    out({"networks": current_networks()})


def control_banner():
    c = control_state()
    if c == domains.CONTROL_OPEN:
        return "OPEN ALL - every website and Discord are allowed; activity is still recorded.\n\n"
    if c == domains.CONTROL_BLOCK:
        return "BLOCK ALL - every website and Discord are blocked (home network as its switch says).\n\n"
    return ""


CONTROL_MESSAGES = {
    domains.CONTROL_FILTERED: "Filtered - the filters apply.",
    domains.CONTROL_BLOCK: "Block all - every website and Discord are blocked.",
    domains.CONTROL_OPEN: "Open all - every website and Discord are allowed; activity is still recorded.",
}


def cmd_control(state, local):
    """The Controls tab's switch.  The firewall stays on in every state, so
    activity is always recorded; only Squid's rules and the Discord voice
    opening change."""
    migrate_legacy()
    write_control(state, "pc" if local else "parent")
    write(RULES_FILE, render_rules(read_mode(), read(ALLOW_FILE).splitlines(), read(BLOCK_FILE).splitlines()))
    code, msg = squid_parse()
    ok, rmsg = (squid_reload() if code == 0 else (False, msg))
    fw_code, fw_msg = apply_firewall_options()
    problems = ([] if ok else ["Squid: " + parse_errors(rmsg)]) + ([] if fw_code == 0 else ["Firewall: " + fw_msg[-300:]])
    out({"ok": not problems, "control": read_control(), "message": CONTROL_MESSAGES[state],
         "errors": problems}, 0 if not problems else 1)


def child_user():
    return conf_value("CHILD_USER")


def cmd_logout():
    """Log the child's account out (every session it has on this PC)."""
    user = child_user()
    if not user:
        out({"ok": False, "message": "No child account is recorded on this PC."}, 1)
    code, text = run(["loginctl", "list-users", "--no-legend"])
    users = [l.split()[1] for l in text.splitlines() if len(l.split()) > 1] if code == 0 else []
    if user not in users:
        out({"ok": True, "logged_out": False, "message": f"{user} is not logged in."})
    code, text = run(["loginctl", "terminate-user", user])
    if code != 0:
        out({"ok": False, "message": f"Could not log {user} out: {text[-300:]}"}, 1)
    out({"ok": True, "logged_out": True, "message": f"{user} has been logged out."})


def cmd_power(action):
    """Shut down or restart in 5 seconds, so this reply reaches the parent app first."""
    verb = "poweroff" if action == "shutdown" else "reboot"
    if have_systemd():
        code, text = run(["systemd-run", "--quiet", "--on-active=5", "--timer-property=AccuracySec=1s",
                          "systemctl", verb])
    else:
        code, text = run(["shutdown", "-h" if action == "shutdown" else "-r", "+0"])
    if code != 0:
        out({"ok": False, "message": f"Could not {'shut down' if action == 'shutdown' else 'restart'} "
                                     f"the PC: {text[-300:]}"}, 1)
    out({"ok": True, "message": ("The PC is shutting down." if action == "shutdown" else "The PC is restarting.")})

# ---- login times and warned actions (since 1.4.0) ---------------------------------
def _shadow_expiry(user):
    """The account's expiry field in /etc/shadow ("" = never), or None if not found."""
    for line in read("/etc/shadow").splitlines():
        parts = line.split(":")
        if len(parts) > 7 and parts[0] == user:
            return parts[7]
    return None


def _lockable(user):
    import pwd
    if not user or user in ("root", ADMIN_USER):
        return False
    try:
        return pwd.getpwnam(user).pw_uid >= 1000
    except KeyError:
        return False


def _is_admin(user):
    if not user:
        return None
    code, groups = run(["id", "-nG", user])
    if code != 0:
        return None
    import pwd
    try:
        if pwd.getpwnam(user).pw_uid == 0:
            return True
    except KeyError:
        return None
    return bool(set(groups.split()) & {"sudo", "admin", "wheel"})


class LinuxPC:
    state_dir = LOGIN_DIR

    def child_user(self):
        return child_user()

    def child_is_admin(self):
        user = child_user()
        if not _lockable(user):
            return None
        return _is_admin(user)

    def set_locked(self, locked):
        user = child_user()
        if not _lockable(user):
            return False, f"'{user}' is not an account Blighter may lock."
        current = _shadow_expiry(user)
        if current is None:
            return False, f"No account '{user}' on this PC."
        if locked:
            if current == "1":
                return True, "already locked"
            os.makedirs(LOGIN_DIR, exist_ok=True)
            with open(PREV_EXPIRE, "w") as f:
                f.write(current + "\n")
            code, text = run(["usermod", "--expiredate", "1", user])
        else:
            if current != "1":
                return True, "not locked"
            prev = read(PREV_EXPIRE).strip()
            if prev == "1":
                prev = ""
            date = ""
            if prev.isdigit():
                date = time.strftime("%Y-%m-%d", time.gmtime(int(prev) * 86400))
            code, text = run(["usermod", "--expiredate", date, user])
        return code == 0, text

    def child_logged_in(self):
        user = child_user()
        if not user:
            return False
        code, state = run(["loginctl", "show-user", user, "-p", "State", "--value"])
        return code == 0 and state.strip() in ("active", "online")

    def logout(self):
        user = child_user()
        code, text = run(["loginctl", "terminate-user", user])
        return code == 0, text

    def power(self, action):
        verb = "poweroff" if action == "shutdown" else "reboot"
        code, text = run(["systemctl", verb]) if have_systemd() else \
            run(["shutdown", "-h" if action == "shutdown" else "-r", "+0"])
        return code == 0, text

    def notify(self, title, text):
        """A desktop notification that stays until dismissed, in each of the
        child's desktop sessions (best effort)."""
        import pwd
        user = child_user()
        try:
            uid = pwd.getpwnam(user).pw_uid
        except KeyError:
            return
        bus = f"/run/user/{uid}/bus"
        if not os.path.exists(bus):
            return
        try:
            subprocess.Popen(["runuser", "-u", user, "--", "env", f"DBUS_SESSION_BUS_ADDRESS=unix:path={bus}",
                              "notify-send", "--urgency=critical", "--app-name=Blighter Restrictor",
                              "--icon=dialog-warning", title, text],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            pass

    def bypassed(self):
        return False

    def log(self, text):
        try:
            subprocess.run(["logger", "-t", "blighter-login", text], timeout=5)
        except (OSError, subprocess.SubprocessError):
            pass


def engine():
    return lockout.Engine(LinuxPC())


def kick_tick():
    """Run the minute check now (in the background) so a change takes effect at once."""
    if have_systemd():
        run(["systemctl", "start", "--no-block", "blighter-login.service"])


def cmd_login_set():
    try:
        data = json.loads(sys.stdin.read(200_000))
    except ValueError:
        out({"ok": False, "message": "Input was not valid JSON"}, 1)
    ok, msg = engine().set_schedule(data)
    if ok:
        kick_tick()
        time.sleep(1.5)
    out({"ok": ok, "message": msg, "login": engine().describe()}, 0 if ok else 1)


def cmd_extend(arg):
    ok, msg = engine().set_extension("" if arg == "end" else arg)
    if ok:
        kick_tick()
        time.sleep(1.5)
    out({"ok": ok, "message": msg, "login": engine().describe()}, 0 if ok else 1)


def cmd_action(action, warn):
    eng = engine()
    if action == "cancel":
        ok, msg = eng.cancel_pending()
    elif warn == 0:
        eng.cancel_pending() if eng.pending() else None
        if action == "logout":
            cmd_logout()
        cmd_power(action)
    else:
        ok, msg = eng.set_pending(action, warn)
        kick_tick()
    out({"ok": ok, "message": msg, "login": eng.describe()}, 0 if ok else 1)


def cmd_tick():
    eng = engine()
    if not os.path.exists(CHILD_CONF):
        return
    eng.tick()


def cmd_release():
    ok, msg = engine().release()
    for name in (lockout.PENDING_FILE, lockout.EXTENSION_FILE):
        try:
            os.remove(os.path.join(LOGIN_DIR, name))
        except FileNotFoundError:
            pass
    out({"ok": ok, "message": msg}, 0 if ok else 1)



def cmd_reload():
    # Rewrite rules.conf too, so a PC set up by an older version gets the
    # current Squid settings (e.g. the neutral error pages).
    if migrate_legacy():
        apply_firewall_options()
    write(RULES_FILE, render_rules(read_mode(), read(ALLOW_FILE).splitlines(), read(BLOCK_FILE).splitlines()))
    code, msg = squid_parse()
    if code != 0:
        out({"ok": False, "message": "Squid configuration check failed",
             "errors": [parse_errors(msg)]}, 1)
    ok, msg = squid_reload()
    out({"ok": ok, "message": "Squid reloaded." if ok else "Reload failed",
         "errors": [] if ok else [msg]}, 0 if ok else 1)


def cmd_log(args):
    try:
        n = max(1, min(int(args[0]) if args else 2000, MAX_LOG_LINES))
    except ValueError:
        sys.exit("log: N must be a number")
    rotated = len(args) > 1 and args[1] == "rotated"
    files = [os.path.join(LOG_DIR, "access.log")]
    if rotated:
        for i in range(1, 15):
            for name in (f"access.log.{i}", f"access.log.{i}.gz"):
                p = os.path.join(LOG_DIR, name)
                if os.path.exists(p):
                    files.append(p)
    collected = []
    for p in files:  # newest first
        try:
            opener = gzip.open if p.endswith(".gz") else open
            with opener(p, "rt", encoding="utf-8", errors="replace") as f:
                lines = f.read().splitlines()
        except FileNotFoundError:
            continue
        collected = lines + collected
        if len(collected) >= n:
            break
    sys.stdout.write("\n".join(collected[-n:]) + "\n")


def _rotated_logs(plain_only):
    """Older logs, newest first (logrotate: access.log.1, then .2.gz ...)."""
    found = []
    for i in range(1, 15):
        for name in (f"access.log.{i}",) + (() if plain_only else (f"access.log.{i}.gz",)):
            p = os.path.join(LOG_DIR, name)
            if os.path.exists(p):
                found.append(p)
    return found


def cmd_logstart(args):
    try:
        n = max(1, min(int(args[0]), MAX_LOG_LINES))
    except (ValueError, IndexError):
        sys.exit("logstart: N must be a number")
    rotated = len(args) > 1 and args[1] == "rotated"
    res = logtail.start(os.path.join(LOG_DIR, "access.log"), _rotated_logs(False), n, rotated)
    res["bypassed"] = False
    res["control"] = read_control()
    out(res)


def cmd_lognext(args):
    if len(args) != 2 or not args[1].isdigit():
        sys.exit("lognext: INO OFFSET")
    ino = "" if args[0] == "-" else args[0]
    res = logtail.next_lines(os.path.join(LOG_DIR, "access.log"), _rotated_logs(True), ino, args[1])
    res["bypassed"] = False
    res["control"] = read_control()
    out(res)


def cmd_init():
    os.makedirs(BASE, exist_ok=True)
    os.chmod(BASE, 0o750)
    try:
        shutil.chown(BASE, "root", "proxy")
    except (LookupError, PermissionError):
        pass
    if not os.path.exists(ALLOW_FILE):
        write(ALLOW_FILE, DEFAULT_ALLOW)
    if not os.path.exists(BLOCK_FILE):
        write(BLOCK_FILE, DEFAULT_BLOCK)
    if not os.path.exists(MODE_FILE):
        write(MODE_FILE, domains.MODE_BLOCKLIST + "\n")
    migrate_legacy()
    allow = read(ALLOW_FILE).splitlines()
    block = read(BLOCK_FILE).splitlines()
    write(RULES_FILE, render_rules(read_mode(), allow, block))
    print("Blighter rule files ready in " + BASE)


# ---- SSH pre-login banner for the parent app's "Find PCs" (since 1.4.0) --------
BANNER_FILE = "/etc/blighter/ssh-banner"


def os_name():
    """'Ubuntu 24.04' from /etc/os-release."""
    vals = {}
    for line in read("/etc/os-release").splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            vals[k.strip()] = v.strip().strip('"')
    return " ".join(x for x in (vals.get("NAME", "Linux"), vals.get("VERSION_ID", "")) if x)


def _banner_part(text):
    """One printable part of the banner (no separator dots, at most 64 characters)."""
    return "".join(c for c in text if c.isprintable() and c != "\u00b7").strip()[:64]


def banner_text():
    host = _banner_part(socket.gethostname().split(".")[0]) or "PC"
    system = _banner_part(os_name()) or "Linux"
    return f"Blighter child {VERSION} \u00b7 {host} \u00b7 {system}\n"


def cmd_banner():
    if not os.path.isdir(os.path.dirname(BANNER_FILE)):
        out({"ok": True, "message": "Blighter is not set up on this PC - no banner written."})
    text = banner_text()
    if read(BANNER_FILE) != text:
        tmp = BANNER_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, 0o644)
        os.replace(tmp, BANNER_FILE)
    out({"ok": True, "message": "SSH banner: " + text.strip()})


USAGE = ("usage: blighter-apply get|status|set|reload|log N [rotated]|logstart N [rotated]|"
         "lognext INO OFFSET|init|netinfo|filtered|block|open [local]|logout|shutdown|restart|"
         "action logout|restart|shutdown 0|5|15|action cancel|login-set|extend HH:MM|end|tick|release|banner")


def main():
    if os.geteuid() != 0:
        sys.exit("blighter-apply must be run as root (via sudo)")
    args = sys.argv[1:]
    if not args:
        sys.exit(USAGE)
    cmd, rest = args[0], args[1:]
    if cmd == "get" and not rest:
        cmd_get()
    elif cmd == "status" and not rest:
        cmd_status()
    elif cmd == "set" and not rest:
        cmd_set()
    elif cmd == "reload" and not rest:
        cmd_reload()
    elif cmd == "log" and len(rest) <= 2:
        cmd_log(rest)
    elif cmd == "logstart" and 1 <= len(rest) <= 2:
        cmd_logstart(rest)
    elif cmd == "lognext" and len(rest) == 2:
        cmd_lognext(rest)
    elif cmd == "init" and not rest:
        cmd_init()
    elif cmd == "netinfo" and not rest:
        cmd_netinfo()
    elif cmd in domains.CONTROLS and rest in ([], ["local"]):
        cmd_control(cmd, bool(rest))
    elif cmd == "logout" and not rest:
        cmd_logout()
    elif cmd in ("shutdown", "restart") and not rest:
        cmd_power(cmd)
    elif cmd == "action" and rest == ["cancel"]:
        cmd_action("cancel", 0)
    elif cmd == "action" and len(rest) == 2 and rest[0] in lockout.ACTIONS and rest[1] in ("0", "5", "15"):
        cmd_action(rest[0], int(rest[1]))
    elif cmd == "login-set" and not rest:
        cmd_login_set()
    elif cmd == "extend" and len(rest) == 1 and (rest[0] == "end" or lockout.parse_hhmm(rest[0]) is not None):
        cmd_extend(rest[0])
    elif cmd == "tick" and not rest:
        cmd_tick()
    elif cmd == "release" and not rest:
        cmd_release()
    elif cmd == "banner" and not rest:
        cmd_banner()
    else:
        sys.exit(USAGE)


if __name__ == "__main__":
    main()
