#!/bin/sh
# Blighter Restrictor child package - post-install message.
# Purpose: reload systemd units and tell the parent how to finish setup;
# on an upgrade, re-apply the firewall and rewrite the Squid rules.
# Copyright (C) 2026 Ian Packer
# SPDX-License-Identifier: GPL-3.0-or-later
# This program is free software: you can redistribute it and/or modify it
# under the terms of the GNU General Public License as published by the Free
# Software Foundation, either version 3 of the License, or (at your option)
# any later version.  It is distributed WITHOUT ANY WARRANTY; see the
# LICENSE file or <https://www.gnu.org/licenses/> for details.
set -e
if [ -d /run/systemd/system ]; then systemctl daemon-reload || true; fi
if [ "$1" = "configure" ]; then
    if [ -f /etc/blighter/child.conf ]; then
        # Upgrade: re-apply firewall with the new script.
        if [ -d /run/systemd/system ]; then systemctl try-restart blighter-firewall.service || true; fi
        # Rewrite the Squid rules with this version's settings (e.g. the
        # neutral error pages) and reload Squid; the lists are kept.
        /usr/sbin/blighter-apply reload >/dev/null 2>&1 || true
    else
        echo ""
        echo "Blighter Restrictor child component installed."
        echo "Install the Blighter Restrictor app on your OWN PC first if you have"
        echo "not already, then finish setup here with:"
        echo "    sudo blighter-setup <child-username>"
        echo ""
    fi
fi
exit 0
